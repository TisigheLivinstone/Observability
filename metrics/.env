# ====================
# Node Exporter
# ====================
NE_IMAGE=quay.io/prometheus/node-exporter:v1.7.0
NE_PORT_PRD=9100           # Port exposed to the host for prd
NE_PRD_TARGET=9100         # Port exposed to the container for prd

# ====================
# cAdvisor
# ====================
CA_IMAGE=gcr.io/cadvisor/cadvisor:v0.49.1
CA_PORT_PRD=8100           # Port exposed to the host for prd
CA_PRD_TARGET=8100         # Port exposed to the container for prd

PROM_IMAGE=prom/prometheus
PROM_PORT=9090             # Port exposed to the host
PROM_TARGET_PORT=9090      # Container port used by Prometheus

# ====================
# Grafana
# ====================
GF_IMAGE=grafana/grafana
GF_PORT=3000               # Port exposed to the host
GF_TARGET_PORT=3000        # Container port used by Grafana
GF_ADMIN_PASSWORD=admin    # Grafana admin password
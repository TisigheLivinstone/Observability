# ====================
# Node Exporter
# ====================
NE_IMAGE=quay.io/prometheus/node-exporter:v1.7.0
NE_PORT_PRD=9100           # Port exposed to the host for prd
NE_PRD_TARGET=9100         # Port exposed to the container for prd

# ====================
# cAdvisor
# ====================
CA_IMAGE=gcr.io/cadvisor/cadvisor:v0.49.1
CA_PORT_PRD=8100           # Port exposed to the host for prd
CA_PRD_TARGET=8100         # Port exposed to the container for prd
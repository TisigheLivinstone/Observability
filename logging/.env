# Images
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:7.17.7
KIBANA_IMAGE=docker.elastic.co/kibana/kibana:7.17.7

# Elasticsearch
ELASTICSEARCH_PORT=9200
ES_JAVA_OPTS=-Xms512m -Xmx512m

# Fluentd
FLUENTD_CONF=fluentd.conf
DOCKER_LOG_PATH=/var/lib/docker/containers

# Kibana
KIBANA_PORT=5601
ELASTICSEARCH_HOSTS=http://elasticsearch:9200